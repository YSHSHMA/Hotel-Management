# Copy to .env (gitignored) when running the backend directly.
# Keep PORT aligned with frontend VITE_API_BASE_URL.
# 5001 avoids macOS AirPlay on 5000 (Control Center). Match frontend VITE_API_BASE_URL.
PORT=5001
FRONTEND_URL=http://localhost:5174
GOOGLE_ID=your-google-oauth-client-id
GOOGLE_SECRET=your-google-oauth-client-secret
MONGODB_CONNECTION_STRING=mongodb://root:root@localhost:27017/hotel-management?authSource=admin
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Google Console redirect URI (add when using Google sign-in locally):
# http://localhost:5001/api/auth/callback/google
